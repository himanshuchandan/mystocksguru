# LLM Configuration
LLM_PROVIDER=gemini  # Options: anthropic, openai, portkey, gemini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PORTKEY_API_KEY=
GEMINI_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Zerodha Kite (Read-only initially)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Database
DATABASE_URL=sqlite:///./market_copilot.db
REDIS_URL=redis://localhost:6379

# App Config
SCAN_INTERVAL_MINUTES=30
MARKET_OPEN_HOUR=9
MARKET_CLOSE_HOUR=16
ENABLE_DASHBOARD=false
SCAN_UNIVERSE=nifty50  # Options: nifty30, nifty50, nifty100, nifty200
MOMENTUM_THRESHOLD=3  # Minimum score (1-5) to include in results
AUTO_DEBATE=true  # Auto-run Bull/Bear debate on top picks (score 4+)
AUTO_DEBATE_TOP_N=2  # Number of top stocks to auto-debate
